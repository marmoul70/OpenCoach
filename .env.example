# OpenCoach - Variables d'environnement
#
# Copier ce fichier :
#
#   cp .env.example .env
#
# Puis générer une clé Fernet :
#
#   ./.venv/bin/python -c \
#     'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#
# Reporter la valeur ci-dessous.
#
# IMPORTANT :
# - ne jamais versionner .env ;
# - conserver cette clé avec les sauvegardes OpenCoach ;
# - une base contenant des credentials chiffrés nécessite la même clé.

OPENCOACH_SECRET_KEY=
