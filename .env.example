# OpenCoach - Variables d'environnement
#
# Copier ce fichier :
#
#   cp .env.example .env
#
# Puis générer une clé Fernet :
#
#   ./.venv/bin/python -c \
#     'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#
# CLÉ DE CHIFFREMENT — OBLIGATOIRE
#
# Générer une clé Fernet avec la commande ci-dessus et la renseigner ici.
# Cette clé chiffre les identifiants des intégrations (Intervals.icu, COROS, etc.).
# CRITIQUE :
# - ne jamais versionner le fichier .env ;
# - sauvegarder cette clé dans un emplacement privé et sécurisé ;
# - conserver exactement la même clé lors d'une restauration ou migration ;
# - si elle est perdue ou remplacée, les secrets déjà chiffrés en base deviennent illisibles.
OPENCOACH_SECRET_KEY=


# E-MAILS TRANSACTIONNELS — REQUIS POUR L'ENVOI DES E-MAILS DE BIENVENUE
#
# OpenCoach utilise SMTP avec STARTTLS. Configuration Brevo recommandée :
# SMTP_HOST : serveur SMTP Brevo (smtp-relay.brevo.com).
# SMTP_PORT : port SMTP STARTTLS (587). Ne pas utiliser 465 avec le client actuel.
# SMTP_USERNAME : identifiant de connexion SMTP indiqué dans Brevo > SMTP & API.
# SMTP_PASSWORD : clé SMTP générée dans Brevo (ce n'est PAS la clé API ni le mot de passe du compte).
# SMTP_FROM_EMAIL : adresse expéditrice vérifiée/authentifiée dans Brevo.
# SMTP_FROM_NAME : nom affiché comme expéditeur (facultatif, valeur par défaut : OpenCoach).
# Sans les cinq variables obligatoires ci-dessous, l'e-mail de bienvenue ne pourra pas être envoyé.
# Les comptes restent créés même si l'envoi de l'e-mail échoue.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpenCoach

# Base de données OpenCoach.
#
# Valeur vide / absente :
#   SQLite local dans data/opencoach.db
#
# Exemple personnalisé :
# OPENCOACH_DATABASE_URL=sqlite:////srv/opencoach/opencoach.db
#
# Pour le fonctionnement standard, laisser cette variable commentée.
# OPENCOACH_DATABASE_URL=


# INTÉGRATIONS SPORTIVES
#
# Les clés API et cookies personnels des utilisateurs sont enregistrés dans la base
# OpenCoach et chiffrés avec OPENCOACH_SECRET_KEY : ils ne doivent pas être placés ici.
# En particulier, OPENCOACH_INTERVALS_WEB_COOKIE n'est plus utilisé : chaque profil
# renseigne son propre cookie dans Paramètres > Intervals.icu.
