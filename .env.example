# OpenCoach - Variables d'environnement
#
# Copier ce fichier :
#
#   cp .env.example .env
#
# Puis générer une clé Fernet :
#
#   ./.venv/bin/python -c \
#     'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#
# CLÉS ET SECRETS — OBLIGATOIRES
#
# Renseigner les valeurs privées dans le fichier .env local.
# Ne jamais versionner .env ni placer de véritables secrets dans ce fichier.
# Conserver les clés avec les sauvegardes OpenCoach :
# - OPENCOACH_SECRET_KEY est nécessaire pour déchiffrer les identifiants d'intégration
#   enregistrés en base ; conserver exactement la même clé lors d'une restauration.
# - OPENCOACH_AUTH_SESSION_SECRET protège les sessions d'authentification.
# - OPENCOACH_VAPID_PRIVATE_KEY doit rester strictement confidentielle.
# Ne pas remplacer ces clés lors d'une restauration d'une installation existante.

OPENCOACH_SECRET_KEY=

# Base de données OpenCoach.
#
# Valeur vide / absente :
#   SQLite local dans data/opencoach.db
#
# Exemple personnalisé :
# OPENCOACH_DATABASE_URL=sqlite:////srv/opencoach/opencoach.db
#
# Pour le fonctionnement standard, laisser cette variable commentée.
# OPENCOACH_DATABASE_URL=

# OpenCoach session authentication
OPENCOACH_AUTH_SESSION_SECRET=
OPENCOACH_AUTH_SESSION_DAYS=
OPENCOACH_AUTH_MAX_ATTEMPTS=
OPENCOACH_AUTH_LOCK_SECONDS=

# OpenCoach Web Push (VAPID)
OPENCOACH_VAPID_PUBLIC_KEY=
OPENCOACH_VAPID_PRIVATE_KEY=
OPENCOACH_VAPID_SUBJECT=

# E-mails transactionnels — SMTP Brevo
#
# OpenCoach utilise SMTP avec STARTTLS. Configuration Brevo recommandée :
# SMTP_HOST : serveur SMTP Brevo (smtp-relay.brevo.com).
# SMTP_PORT : port SMTP STARTTLS (587). Ne pas utiliser 465 avec le client actuel.
# SMTP_USERNAME : identifiant de connexion SMTP indiqué dans Brevo > SMTP & API.
# SMTP_PASSWORD : clé SMTP générée dans Brevo (ce n'est PAS la clé API ni le mot de passe du compte).
# SMTP_FROM_EMAIL : adresse expéditrice vérifiée/authentifiée dans Brevo.
# SMTP_FROM_NAME : nom affiché comme expéditeur (facultatif, valeur par défaut : OpenCoach).
# Sans les cinq variables SMTP obligatoires, l'e-mail de bienvenue ne pourra pas être envoyé.
# Les comptes restent créés même si l'envoi de l'e-mail échoue.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpenCoach

# INTÉGRATIONS SPORTIVES
#
# Les clés API et cookies personnels des utilisateurs sont enregistrés dans la base
# OpenCoach et chiffrés avec OPENCOACH_SECRET_KEY : ils ne doivent pas être placés ici.
# En particulier, OPENCOACH_INTERVALS_WEB_COOKIE n'est plus utilisé : chaque profil
# renseigne son propre cookie dans Paramètres > Intervals.icu.

# MOTEUR IA LOCAL (OLLAMA)
#
# L'IA reste désactivée par défaut. Ollama doit être installé localement
# avant d'activer OPENCOACH_AI_ENABLED.
OPENCOACH_AI_ENABLED=false
OPENCOACH_AI_PROVIDER=ollama
OPENCOACH_AI_BASE_URL=http://127.0.0.1:11434
OPENCOACH_AI_MODEL=qwen3:8b
OPENCOACH_AI_CONNECT_TIMEOUT_SECONDS=2
OPENCOACH_AI_READ_TIMEOUT_SECONDS=240
OPENCOACH_AI_MAX_CONCURRENCY=1
