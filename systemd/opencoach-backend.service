[Unit]
Description=OpenCoach backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@OPENCOACH_USER@
Group=@OPENCOACH_GROUP@
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=@PROJECT_ROOT@/.env

ExecStart=@PROJECT_ROOT@/.venv/bin/python -m uvicorn opencoach.api.app:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
